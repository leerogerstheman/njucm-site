---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CopyEmail from '../../components/CopyEmail.astro';
import { SITE } from '../../data/site';
import { getDocs, getRawEntry } from '../../utils/content';

const docs = await getDocs('about');

// About is a single page: every entry in src/content/about/ is rendered in order.
const rendered = await Promise.all(
  docs.map(async (doc) => {
    const entry = await getRawEntry('about', doc.slug);
    const { Content } = await render(entry);
    return { doc, Content };
  })
);
---

<BaseLayout title="About" description="关于 njucm.org 这个站点。">
  <header class="page-head wrap--narrow">
    <p class="eyebrow">About</p>
    <h1>关于本站</h1>
    <p class="page-head__desc">{SITE.description}</p>
  </header>

  <div class="prose-narrow">
    {rendered.map(({ doc, Content }) => (
      <section class="article__body">
        <h2>{doc.title}</h2>
        <Content />
      </section>
    ))}

    <hr />

    <h2>联系</h2>
    <ul>
      <li>
        <CopyEmail email={SITE.email} label="邮箱：" />
      </li>
      <li>
        GitHub：
        <a href={SITE.github} rel="noopener noreferrer" target="_blank">@{SITE.author}</a>
      </li>
      <li>站点：<a href="https://njucm.org">njucm.org</a></li>
    </ul>
  </div>
</BaseLayout>
