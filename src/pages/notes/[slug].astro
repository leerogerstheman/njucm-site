---
import { render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import Comments from '../../components/Comments.astro';
import { COMMENTS } from '../../data/site';
import { getDocs, getRawEntry } from '../../utils/content';

export async function getStaticPaths() {
  const docs = await getDocs('notes');
  return docs.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

const { doc } = Astro.props;

const entry = await getRawEntry('notes', doc.slug);
const { Content, headings } = await render(entry);
---

<DocLayout doc={doc} sectionLabel="Notes" headings={headings}>
  <Content />
  {COMMENTS.enabled && <Comments slug={doc.slug} api={COMMENTS.api} />}
</DocLayout>
