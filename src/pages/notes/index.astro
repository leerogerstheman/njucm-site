---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionIndex from '../../components/SectionIndex.astro';
import { NAV } from '../../data/site';
import { getDocs } from '../../utils/content';

const item = NAV.find((i) => i.href === '/notes')!;
const docs = await getDocs('notes');
---

<BaseLayout title={item.label} description={item.desc}>
  <SectionIndex
    item={item}
    docs={docs}
    emptyHint="还没有笔记。在 src/content/notes/ 下新建 .md 文件即可出现在这里。"
  />
</BaseLayout>
