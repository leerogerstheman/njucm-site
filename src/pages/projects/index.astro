---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionIndex from '../../components/SectionIndex.astro';
import { NAV } from '../../data/site';
import { DOMAINS } from '../../data/taxonomy';
import { getDocs } from '../../utils/content';

const item = NAV.find((i) => i.href === '/projects')!;
const docs = await getDocs('projects');

/**
 * Sort modes offered above the list. `random` stays the default (and clicking it
 * re-rolls), because the cards were originally asked to reshuffle on every visit.
 */
const SORTS = [
  { id: 'random', label: '随机', hint: '每次进入重新打乱；再点一次可重新洗牌' },
  { id: 'updated', label: '最新更新', hint: '按仓库最后更新时间排序，最近更新的在前' },
  { id: 'created', label: '最新上传', hint: '按仓库上传到 GitHub 的时间排序，最新的在前' },
];

/** 只列出真正有项目的领域，空领域不占一个按钮 */
const usedDomains = DOMAINS.filter((d) => docs.some((doc) => doc.domain === d.id));
const counts = new Map(usedDomains.map((d) => [d.id, docs.filter((doc) => doc.domain === d.id).length]));
---

<BaseLayout title={item.label} description={item.desc} preload={['/scripts/projects.js?v=1']}>
  <SectionIndex
    item={item}
    docs={docs}
    sortable
    filterable
    glyph="projects"
    emptyHint="还没有项目条目。在 src/content/projects/ 下新建 .md 文件即可出现在这里。"
  >
    <div slot="before-list" class="sorter" data-sorter>
      <div class="sorter__row">
        <span class="sorter__label" id="sorter-label">排序</span>
        <div class="sorter__group" role="group" aria-labelledby="sorter-label">
          {
            SORTS.map((s, i) => (
              <button
                type="button"
                class="sorter__btn"
                data-sort={s.id}
                data-hint={s.hint}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {s.label}
              </button>
            ))
          }
        </div>
        <p class="sorter__hint" data-sort-hint aria-live="polite">{SORTS[0].hint}</p>
      </div>

      <div class="sorter__row">
        <span class="sorter__label" id="filter-label">领域</span>
        <div class="sorter__group" role="group" aria-labelledby="filter-label">
          <button type="button" class="sorter__btn" data-filter="" aria-pressed="true">
            全部<span class="sorter__count">{docs.length}</span>
          </button>
          {
            usedDomains.map((d) => (
              <button type="button" class="sorter__btn" data-filter={d.id} aria-pressed="false">
                {d.label}
                <span class="sorter__count">{counts.get(d.id)}</span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </SectionIndex>
</BaseLayout>

<script is:inline src="/scripts/projects.js?v=1"></script>
