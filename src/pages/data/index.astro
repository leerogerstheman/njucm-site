---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionIndex from '../../components/SectionIndex.astro';
import { NAV } from '../../data/site';
import { getDocs } from '../../utils/content';
import { PRODUCTS } from '../../data/models';
import '../../styles/models.css';

const item = NAV.find((i) => i.href === '/data')!;
const docs = await getDocs('data');
---

<BaseLayout title={item.label} description={item.desc}>
  <SectionIndex
    item={item}
    docs={docs}
    glyph="data"
    emptyHint="还没有数据集。在 src/content/data/ 下新建 .md 文件即可出现在这里。"
  >
    <div slot="before-list" class="gdb-featured">
      <a class="gdb-featured__link" href="/data/models/">
        <span class="gdb-featured__badge">Database</span>
        <span class="gdb-featured__title">模型数据库</span>
        <span class="gdb-featured__desc">
          按厂商、品类、作品线、主题、发售年代与官方定价检索的模型条目，共 {PRODUCTS.length} 条。
          每条记录都标明出处与核实状态。
        </span>
        <span class="gdb-featured__cta">进入数据库 →</span>
      </a>
    </div>
  </SectionIndex>
</BaseLayout>
