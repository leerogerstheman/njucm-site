---
/**
 * 条目并排对比
 *
 * 主题页给的是「同一台机体各品类之间」的对比——那是最常见的一类。
 * 这一页管的是另一类：几台不同的机体，或者同一台的不同定位，放在一起看参数。
 *
 * 数据不在服务端渲染：条目有 1742 条，为一个对比页把整库塞进 HTML 不划算。
 * 页面取的是列表页那份索引（/data/models/index.json），从 URL 的 ids 参数里
 * 挑出要对比的那几条。挑不中就退回浏览器里存的对比栏选择。
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CompareBar from '../../../components/models/CompareBar.astro';
import '../../../styles/models.css';
import '../../../styles/gundam-theme.css';
---

<BaseLayout
  title="条目对比"
  description="把几个高达模型条目并排放，逐行比较品类、比例、发售、定价、零件数与主题归属。"
  scope="gundam"
  preload={['/scripts/compare.js?v=1']}
>
  <nav class="gbreadcrumb" aria-label="面包屑">
    <a href="/data/">Data</a>
    <span aria-hidden="true">/</span>
    <a href="/data/models/">模型数据库</a>
    <span aria-hidden="true">/</span>
    <span class="faint">条目对比</span>
  </nav>

  <header class="page-head" data-reveal>
    <p class="eyebrow">对比</p>
    <h1>条目对比</h1>
    <p class="page-head__desc">
      选两到六条放进同一张表里，逐行比较品类、比例、发售、官方定价、零件数与
      主题归属。选中状态存在你自己的浏览器里，不会传到服务端；地址栏里的
      <code>?ids=</code> 可以直接分享给别人。
    </p>
    <p class="gdb__tools">
      <a href="/data/models/">条目列表</a>
      <span aria-hidden="true">·</span>
      <a href="/data/models/subject/">按主题浏览</a>
      <span aria-hidden="true">·</span>
      <a href="/data/models/series/">按作品线浏览</a>
    </p>
  </header>

  <section class="gcmppage" data-reveal>
    <div class="gcmppage__bar">
      <p class="gcmppage__count" data-cmp-count aria-live="polite">尚未选择条目</p>
      <p class="gcmppage__hint">
        在
        <a href="/data/models/">条目列表</a>或
        <a href="/data/models/subject/">主题索引</a>里挑，或从条目详情页点「加入对比」。
      </p>
    </div>
    <div class="gcmppage__scroll" data-cmp-body></div>
  </section>

  <noscript>
    <p class="empty">
      对比页需要 JavaScript 才能读取选中状态。没有它的话，可以直接打开
      <a href="/data/models/">条目列表</a>逐个查看，或到
      <a href="/data/models/subject/">主题页</a>看同一台机体的各等级横向对比。
    </p>
  </noscript>

  <CompareBar />
</BaseLayout>

<script is:inline src="/scripts/compare.js?v=1"></script>

<style is:global>
  .gcmppage {
    margin: 2rem 0 0;
  }

  .gcmppage__bar {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin-bottom: 1rem;
  }

  .gcmppage__count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--accent);
  }

  .gcmppage__hint {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-faint);
  }

  .gcmppage__scroll {
    overflow-x: auto;
  }

  .gcmppage__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
    min-width: 34rem;
  }

  .gcmppage__table th[scope='row'] {
    text-align: left;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--text-faint);
    padding: 0.5rem 0.7rem 0.5rem 0;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
    vertical-align: top;
    width: 8rem;
  }

  .gcmppage__table thead th {
    text-align: left;
    font-family: inherit;
    font-size: var(--fs-sm);
    font-weight: 640;
    letter-spacing: normal;
    text-transform: none;
    color: var(--text);
    padding: 0 0.7rem 0.6rem 0;
    border-bottom: 1px solid var(--line-strong);
    vertical-align: bottom;
    min-width: 11rem;
    /* 全局表格样式给 thead th 加了 nowrap，品名一长就互相压住了 */
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .gcmppage__table td {
    padding: 0.5rem 0.7rem 0.5rem 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .gcmppage__table tbody tr:hover td,
  .gcmppage__table tbody tr:hover th {
    background: var(--surface);
  }

  .gcmppage__row--remove td {
    border-bottom: none;
    padding-top: 0.8rem;
  }

  .gcmppage__col {
    max-width: 16rem;
  }

  .gcmppage__img {
    display: block;
    width: 8rem;
    height: 8rem;
    max-width: 100%;
    object-fit: contain;
    border-radius: var(--radius-xs);
    background: #fff;
  }

  .gcmppage__img--none {
    padding: 1.4rem 0;
    text-align: center;
    font-size: var(--fs-2xs);
    color: var(--text-faint);
    background: var(--surface-2);
  }

  .gcmppage__ja {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    color: var(--text-faint);
  }

  .gcmppage__mono {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .gcmppage__hint {
    margin-left: 0.35rem;
    font-size: var(--fs-2xs);
    color: var(--text-faint);
  }

  .gcmppage__aliases {
    font-size: var(--fs-xs);
    color: var(--text-dim);
  }

  .gcmppage__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .gcmppage__tags a {
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: var(--fs-2xs);
    color: var(--text-dim);
    background-image: none;
  }

  .gcmppage__tags a:hover {
    background-image: none;
    color: var(--accent);
    border-color: var(--accent-line);
  }

  .gcmppage__remove {
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.12rem 0.6rem;
    background: var(--surface);
    color: var(--text-faint);
    font-size: var(--fs-2xs);
    cursor: pointer;
  }

  .gcmppage__remove:hover {
    color: var(--accent);
    border-color: var(--accent-line);
  }
</style>
