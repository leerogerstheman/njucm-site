---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import KitBrowser from '../../../components/models/KitBrowser.astro';
import KitStats from '../../../components/models/KitStats.astro';
import CompareBar from '../../../components/models/CompareBar.astro';
import ArtDefs from '../../../components/models/ArtDefs.astro';
import { PRODUCTS, releaseYear, MAKERS } from '../../../data/models';
import '../../../styles/models.css';
import '../../../styles/gundam-theme.css';

const years = PRODUCTS.map((k) => releaseYear(k.released)).filter(Boolean);
const span = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '—';
const categories = new Set(PRODUCTS.map((k) => k.category)).size;
const seriesCount = new Set(PRODUCTS.map((k) => k.series)).size;
const makers = MAKERS.filter((m) => PRODUCTS.some((k) => k.maker === m.id));

const description =
  '覆盖万代、寿屋、良笑、魔动核等厂商的模型产品数据库：按厂商、品类、作品线、主题与发售年代检索，每条记录都标注出处与核实状态。';
---

<BaseLayout title="模型数据库" description={description} scope="gundam">
  <ArtDefs />

  <header class="page-head" data-reveal>
    <p class="eyebrow">Data</p>
    <h1>模型数据库</h1>
    <p class="page-head__desc">
      把分散在各家厂商目录里的模型资料收拢成一张可检索的表：厂商、品类、作品线、
      主题、发售时间、官方定价与销售渠道。每条记录都标明它是从哪儿核来的。
    </p>
    <p class="count" style="margin:1rem 0 0">
      {PRODUCTS.length} 条 · {makers.length} 家厂商 · {categories} 个品类 · {seriesCount} 条作品线 ·
      发售年份 {span}
    </p>
    <p class="gdb__tools">
      <a href="/data/models/subject/">按主题浏览</a>
      <span aria-hidden="true">·</span>
      <a href="/data/models/series/">按作品线浏览</a>
      <span aria-hidden="true">·</span>
      <a href="/data/models/stats/">数据概览</a>
      <span aria-hidden="true">·</span>
      <a href="/data/models/export.json" download>导出 JSON</a>
      <span aria-hidden="true">·</span>
      <a href="/data/models/export.csv" download>导出 CSV</a>
      <span aria-hidden="true">·</span>
      <a href="/data/models-database/">字段口径</a>
    </p>
  </header>

  <KitStats kits={PRODUCTS} />

  <KitBrowser kits={PRODUCTS} />

  <CompareBar />
</BaseLayout>
