---
import { render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import { getDocs, getRawEntry } from '../../utils/content';

export async function getStaticPaths() {
  const docs = await getDocs('data');
  return docs.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

const { doc } = Astro.props;

const entry = await getRawEntry('data', doc.slug);
const { Content, headings } = await render(entry);
---

<DocLayout doc={doc} sectionLabel="Data" headings={headings}>
  <Content />
</DocLayout>