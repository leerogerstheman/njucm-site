---
/**
 * 机体页：同一台机体的所有版本
 *
 * 对比表是这一页的核心——把不同等级的同类产品并排放，尺寸、零件数、
 * 定价、发售日、渠道一眼可比。这是同类站「参数对比」最常用的场景。
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import KitCard from '../../../../components/gundam/KitCard.astro';
import MECHES from '../../../../data/gundam.mechs.json';
import { KITS, seriesMeta, gradeMeta, formatJPY, releaseLabel } from '../../../../data/gundam';
import '../../../../styles/gundam.css';
import '../../../../styles/gundam-theme.css';

interface MechEntry {
  label: string;
  en: string | null;
  alt: string[];
  count: number;
  grades: Record<string, number>;
  series: string[];
  kits: string[];
}

export async function getStaticPaths() {
  return Object.entries(MECHES as Record<string, MechEntry>).map(([key, mech]) => ({
    params: { key },
    props: { key, mech },
  }));
}

const { key, mech } = Astro.props as { key: string; mech: MechEntry };

const byId = new Map(KITS.map((k) => [k.id, k]));
const versions = mech.kits.map((id) => byId.get(id)).filter(Boolean);

/* 按发售时间排，早的在前——同一台机器通常是先小后大 */
versions.sort((a, b) => a.released.localeCompare(b.released) || a.grade.localeCompare(b.grade));

const knownSeries = [...new Set(mech.series.filter((s) => s && s !== 'other'))].map((s) => seriesMeta(s));
const hasPrice = versions.some((v) => v.priceJpy > 0);
const hasSize = versions.some((v) => v.heightMm !== null || v.parts !== null);
---

<BaseLayout
  title={mech.label}
  description={`${mech.label}（${mech.en ?? ''}）在库里的 ${mech.count} 个版本：等级、比例、发售日、官方定价与渠道的横向对比。`}
  scope="gundam"
>
  <nav class="gbreadcrumb" aria-label="面包屑">
    <a href="/data/">Data</a>
    <span aria-hidden="true">/</span>
    <a href="/data/gundam/">高达模型数据库</a>
    <span aria-hidden="true">/</span>
    <a href="/data/gundam/mech/">按机体浏览</a>
    <span aria-hidden="true">/</span>
    <span class="faint">{mech.label}</span>
  </nav>

  <header class="page-head" data-reveal>
    <p class="eyebrow">机体</p>
    <h1>{mech.label}</h1>
    {mech.en && <p class="gmechpage__en">{mech.en}</p>}
    {
      knownSeries.length > 0 && (
        <p class="gmechpage__series">
          {knownSeries.map((s) => (
            <a href={`/data/gundam/?series=${s.id}`}>{s.label}</a>
          ))}
        </p>
      )
    }
    <p class="count" style="margin:1rem 0 0">
      {mech.count} 个版本 · {Object.keys(mech.grades).length} 个等级
    </p>
    {
      mech.alt.length > 0 && (
        <p class="gmechpage__alt">
          又名 {mech.alt.join(' · ')}
        </p>
      )
    }
  </header>

  <section class="gmechpage" data-reveal>
    <h2 class="gmechpage__title">版本对比</h2>
    <div class="gmechpage__scroll">
      <table class="gmechtable">
        <thead>
          <tr>
            <th scope="col">等级</th>
            <th scope="col">比例</th>
            <th scope="col">品名</th>
            <th scope="col">发售</th>
            {hasPrice && <th scope="col">官方定价</th>}
            <th scope="col">渠道</th>
            {hasSize && <th scope="col">全高 / 零件数</th>}
          </tr>
        </thead>
        <tbody>
          {
            versions.map((v) => (
              <tr>
                <td>
                  <span class="gmechtable__grade" data-grade={v.grade}>
                    {v.grade}
                  </span>
                </td>
                <td class="gmechtable__num">{v.scale}</td>
                <td>
                  <a href={`/data/gundam/${v.id}/`}>{v.name}</a>
                  {v.nameJa && <span class="gmechtable__ja">{v.nameJa}</span>}
                </td>
                <td class="gmechtable__num">{releaseLabel(v.released)}</td>
                {hasPrice && (
                  <td class="gmechtable__num">
                    {v.priceJpy > 0 ? formatJPY(v.priceJpy) : v.priceCny > 0 ? `¥${v.priceCny.toLocaleString('en-US')}` : '—'}
                  </td>
                )}
                <td class="gmechtable__chan">{v.channel === 'pb' ? 'PB 限定' : v.channel === 'gb' ? '高达基地' : v.channel === 'wt' ? '网络限定' : '一般销售'}</td>
                {hasSize && (
                  <td class="gmechtable__num">
                    {v.heightMm !== null ? `约 ${v.heightMm} mm` : ''}
                    {v.heightMm !== null && v.parts !== null && ' / '}
                    {v.parts !== null ? `${v.parts} 件` : ''}
                    {v.heightMm === null && v.parts === null && '—'}
                  </td>
                )}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="gmechpage" data-reveal>
    <h2 class="gmechpage__title">商品</h2>
    <div class="gdb__grid" data-grid>
      {versions.map((v) => <KitCard kit={v} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .gmechpage {
    margin: 2rem 0 0;
  }

  .gmechpage__title {
    font-size: var(--fs-lg);
    margin: 0 0 0.8rem;
  }

  .gmechpage__en {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--text-faint);
    margin: 0.35rem 0 0;
  }

  .gmechpage__series {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    font-size: var(--fs-sm);
  }

  .gmechpage__series a {
    color: var(--accent);
  }

  .gmechpage__alt {
    margin: 0.6rem 0 0;
    font-size: var(--fs-xs);
    color: var(--text-faint);
  }

  .gmechpage__scroll {
    overflow-x: auto;
  }

  .gmechtable {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }

  .gmechtable th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 500;
    white-space: nowrap;
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .gmechtable td {
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .gmechtable tbody tr:hover {
    background: var(--surface);
  }

  .gmechtable a {
    color: var(--accent);
  }

  .gmechtable__num {
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .gmechtable__ja {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    color: var(--text-faint);
  }

  .gmechtable__chan {
    font-size: var(--fs-xs);
    color: var(--text-dim);
    white-space: nowrap;
  }

  .gmechtable__grade {
    display: inline-block;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-xs);
    background: var(--accent-soft);
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent-line);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
  }
</style>
