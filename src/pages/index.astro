---
import BaseLayout from '../layouts/BaseLayout.astro';
import DocList from '../components/DocList.astro';
import { SITE, NAV } from '../data/site';
import { getDocs } from '../utils/content';

const [notes, data, projects] = await Promise.all([
  getDocs('notes'),
  getDocs('data'),
  getDocs('projects'),
]);

const latest = notes.slice(0, 3);

const counts: Record<string, number> = {
  '/notes': notes.length,
  '/data': data.length,
  '/projects': projects.length,
};

const totalEntries = notes.length + data.length + projects.length;
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Independent research site</p>
    <h1>{SITE.title}<span class="faint">.org</span></h1>
    <p class="hero__lede">{SITE.description}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/notes">浏览 Notes</a>
      <a class="btn" href="/about">关于本站</a>
    </div>
  </section>

  {
    latest.length > 0 && (
      <section class="section-block">
        <div class="section-block__head">
          <h2>最新笔记</h2>
          <a href="/notes">全部 →</a>
        </div>
        <DocList docs={latest} columns={3} />
      </section>
    )
  }

  <section class="section-block">
    <div class="section-block__head">
      <h2>栏目</h2>
      <span class="count">
        {NAV.length} sections · {totalEntries} {totalEntries === 1 ? 'entry' : 'entries'}
      </span>
    </div>

    <div class="grid">
      {
        NAV.map((item) => (
          <article class="card">
            <h3 class="card__title">
              <a href={item.href}>{item.label}</a>
            </h3>
            <p class="card__desc">{item.desc}</p>
            <div class="card__meta">
              <span>
                {counts[item.href] === undefined
                  ? '—'
                  : `${counts[item.href]} ${counts[item.href] === 1 ? 'entry' : 'entries'}`}
              </span>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
