---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { CSP_META_CONTENT } from '../utils/csp';
import '../styles/global.css';
import '../styles/header.css';
import '../styles/footer.css';

interface Props {
  /** full <title>; falls back to the site title */
  title?: string;
  description?: string;
  /** set on article pages so the title reads "page · site" */
  isArticle?: boolean;
  /**
   * 页面自己的脚本，提前抓起来。
   *
   * 这些脚本要在解析到它们的位置时立刻执行（项目卡片要先排好序再首帧），
   * 所以它们是「阻塞式外部脚本」而不是延迟模块。浏览器是边解析边下载的，
   * 等它解析到脚本标签才去请求，就晚了一轮往返；这里先声明一遍，抓取与
   * 解析并行，脚本到达时基本已经躺在缓存里。
   */
  preload?: string[];
  /**
   * 局部主题分区。
   *
   * 某些栏目自带一套自己的配色（比如高达模型数据库用吉翁公国的红与金）。
   * 写进 <html> 的 data-scope，样式表据此只在这一节里换掉令牌，
   * 站点的其余部分仍是原来的配色。
   */
  scope?: string;
}

const { title, description = SITE.description, isArticle = false, scope, preload = [] } = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.domain}`;

const siteOrigin = Astro.site ?? new URL('https://njucm.org');
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
/* 分享卡片必须是绝对 URL，相对路径在各家抓取器里都会被当成无效 */
const ogImage = new URL('/og.png', siteOrigin).href;
---

<!doctype html>
<html lang={SITE.lang} data-scope={scope}>
  <head>
    <meta charset="utf-8" />
    {/*
      内容安全策略。
      放在 head 最前面：meta 形式的策略只对它之后解析到的内容生效，
      放晚了，前面那几行就漏在闸门外面了。
      策略正文见 src/utils/csp.ts，与 Cloudflare 响应头用的是同一份。
    */}
    <meta http-equiv="Content-Security-Policy" content={CSP_META_CONTENT} />
    {preload.map((href) => <link rel="preload" as="script" href={href} />)}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0c1012" />
    <meta name="author" content={SITE.author} />

    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.title} — ${SITE.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    {/*
      Applies a previously chosen theme before the first paint, so a light-theme
      visitor never sees a dark flash.

      External, not inline: an inline script would need a CSP hash, and the
      hash changes whenever this code changes — which would silently break
      the rule copied into Cloudflare. Same-origin files pass 'self' forever.

      preload + async: the fetch starts while the head is still parsing, and
      async keeps the parser running so the stylesheets are discovered at the
      same time instead of one round trip later.
    */}
    <link rel="preload" as="script" href="/scripts/theme.js?v=1" />
    <script is:inline src="/scripts/theme.js?v=1" async></script>
  </head>

  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header />
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
