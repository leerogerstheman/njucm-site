---
/**
 * 数据概览 · 年代分布与品类构成
 *
 * 这些数字全部由条目本身算出来，没有任何外部统计口径：年代分布回答
 * "这条产品线长什么样"，品类构成回答"库里都收了些什么"。放在列表上方，
 * 是为了让访客先看到全局，再挑自己要看的那一格。
 */
import { countBy, categoryMeta, releaseYear, decadeOf, type ModelProduct , categoryMeta } from '../../data/models';

interface Props {
  kits: ModelProduct[];
}

const { kits } = Astro.props;

/**
 * 年代口径。
 *
 * 有发售日的用发售日；官网没给发售日的（田宫的商城只给上架日）按上架年计，
 * 与列表页的年代分面是同一套口径。
 */
const yearOf = (k: ModelProduct) => releaseYear(k.released) || releaseYear(k.listedAt);

/** 按年代分桶，空的年代也保留，好让横轴的时间感是连续的 */
const decadeCounts = countBy(kits, (k) => decadeOf(yearOf(k)), (id) => id);
const decades = [...decadeCounts].sort((a, b) => a.id.localeCompare(b.id));
const decadeMax = Math.max(1, ...decades.map((d) => d.count));

const categoryCounts = countBy(kits, (k) => k.category, (id) => categoryMeta(id).label);
const categoryMax = Math.max(1, ...categoryCounts.map((g) => g.count));
/** 最多的两条品类线，按条目数说话，不写死 */
const topGrades = categoryCounts.slice(0, 2).map((g) => g.label).join(' 与 ');
const hasAssemble = kits.some((k) => k.category === 'bandai:ga');

const earliest = kits.reduce(
  (min, k) => (yearOf(k) && (!min || yearOf(k) < yearOf(min)) ? k : min),
  null as ModelProduct | null,
);
const latest = kits.reduce(
  (max, k) => (yearOf(k) > yearOf(max) ? k : max),
  kits[0],
);
---

<section class="gstats" aria-label="数据库概览">
  <div class="gstats__block">
    <h2 class="gstats__title">年代分布</h2>
    <p class="gstats__desc">
      按发售年份统计收录条目；官网没给发售日的（田宫那批只有商城上架日）按上架年
      计。库里的时间跨度从 {earliest ? yearOf(earliest) : '—'} 年到
      {latest ? yearOf(latest) : '—'} 年。
    </p>
    <ul class="gstats__bars">
      {
        decades.map((d) => (
          <li class="gstats__bar-row">
            <span class="gstats__bar-label">{d.id}</span>
            <span class="gstats__bar-track">
              <span class="gstats__bar-fill" style={`--w:${(d.count / decadeMax) * 100}%`} />
            </span>
            <span class="gstats__bar-num">{d.count}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="gstats__block">
    <h2 class="gstats__title">品类构成</h2>
    <p class="gstats__desc">
      {topGrades} 是收录最多的两条线；零件数与全高这类数字，官方站普遍不标，
      所以覆盖率不高——缺就缺着，不估算。
      {hasAssemble && 'GA 是 2026 年起新增的桌面战棋线（高达集结）。'}
    </p>
    <ul class="gstats__bars">
      {
        categoryCounts.map((g) => (
          <li class="gstats__bar-row">
            <span class="gstats__bar-label">{g.label}</span>
            <span class="gstats__bar-track">
              <span class="gstats__bar-fill" data-category={g.id} style={`--w:${(g.count / categoryMax) * 100}%`} />
            </span>
            <span class="gstats__bar-num">{g.count}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
