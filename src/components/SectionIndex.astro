---
import type { NavItem } from '../data/site';
import DocList from '../components/DocList.astro';
import type { Doc } from '../utils/content';

interface Props {
  item: NavItem;
  docs: Doc[];
  emptyHint?: string;
  /** let the client reorder the cards (see DocList) */
  sortable?: boolean;
}

const { item, docs, emptyHint, sortable = false } = Astro.props;
---

<header class="page-head">
  <p class="eyebrow">{item.label}</p>
  <h1>{item.label}</h1>
  <p class="page-head__desc">{item.desc}</p>
  <p class="count" style="margin:1rem 0 0">{docs.length} 篇</p>
</header>

<!-- the /projects page drops its sort control in here -->
<slot name="before-list" />

<DocList docs={docs} emptyHint={emptyHint} sortable={sortable} />
