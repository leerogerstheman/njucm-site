---
import type { NavItem } from '../data/site';
import DocList from '../components/DocList.astro';
import SectionGlyph from '../components/SectionGlyph.astro';
import type { Doc } from '../utils/content';

interface Props {
  item: NavItem;
  docs: Doc[];
  emptyHint?: string;
  /** let the client reorder the cards (see DocList) */
  sortable?: boolean;
  /** let the client narrow the cards by domain (see data/taxonomy.ts) */
  filterable?: boolean;
  /** 栏目线稿；省略则不显示 */
  glyph?: 'notes' | 'data' | 'projects' | 'about';
}

const { item, docs, emptyHint, sortable = false, filterable = false, glyph } = Astro.props;
---

<header class="page-head" data-reveal>
  <p class:list={['eyebrow', { 'eyebrow--glyph': Boolean(glyph) }]}>
    {glyph && (
      <span class="page-head__glyph">
        <SectionGlyph name={glyph} />
      </span>
    )}
    {item.label}
  </p>
  <h1>{item.label}</h1>
  <p class="page-head__desc">{item.desc}</p>
  <p class="count" style="margin:1rem 0 0">{docs.length} 篇</p>
</header>

<!-- the /projects page drops its sort control in here -->
<slot name="before-list" />

<DocList docs={docs} emptyHint={emptyHint} sortable={sortable} filterable={filterable} />
