---
/**
 * 条目浏览器：搜索、分面、排序与分页
 *
 * 1742 条记录全部内联进 HTML，列表页会有 2 MB。所以这里分成两半：
 *
 *   服务端  只渲染第一页的卡片（60 张），没有脚本也能看到内容，爬虫也能读到
 *   客户端  取回完整数据索引（index.json），自己做筛选、排序与分页
 *
 * 两边共用同一套口径：归一化、年代分档、价格分档都写在下面的脚本里，
 * 计数也全部由客户端按当前条件重算，所以分面上的数字永远和列表一致。
 */
import {
  KITS,
  seriesMeta,
  channelMeta,
  gradeMeta,
  releaseShort,
  releaseYear,
  releaseSortKey,
  searchHaystack,
  type GundamKit,
} from '../../data/gundam';

interface Props {
  kits: GundamKit[];
}

const { kits } = Astro.props;

const PAGE_SIZE = 60;

/* 首屏：服务端渲染的第一页 */
const firstPage = kits.slice(0, PAGE_SIZE);

/* 分面用的计数（客户端会用同一套算法重算，这里给首屏一个正确的起点） */
const countByKey = (pick: (k: GundamKit) => string) => {
  const m = new Map<string, number>();
  for (const kit of kits) {
    const key = pick(kit);
    m.set(key, (m.get(key) ?? 0) + 1);
  }
  return m;
};

const gradeCounts = countByKey((k) => k.grade);
const channelCounts = countByKey((k) => k.channel);
const decadeCounts = countByKey((k) => {
  const y = releaseYear(k.released);
  return y ? `${Math.floor(y / 10) * 10}s` : '未知';
});
const priceCounts = countByKey((k) => {
  if (!k.priceJpy) return 'unknown';
  if (k.priceJpy <= 1000) return '0-1000';
  if (k.priceJpy <= 3000) return '1001-3000';
  if (k.priceJpy <= 6000) return '3001-6000';
  return '6001+';
});

const usedGrades = [...gradeCounts.keys()].sort(
  (a, b) => (gradeCounts.get(b) ?? 0) - (gradeCounts.get(a) ?? 0),
);
const usedChannels = [...channelCounts.keys()];
const usedSeries = [...new Set(kits.map((k) => k.series))].sort(
  (a, b) => (seriesMeta(b).label).localeCompare(seriesMeta(a).label, 'zh-Hans-CN'),
);
const usedDecades = [...decadeCounts.keys()].sort();

const PRICE_BUCKETS = [
  { id: '0-1000', label: '¥1,000 以下' },
  { id: '1001-3000', label: '¥1,000–3,000' },
  { id: '3001-6000', label: '¥3,000–6,000' },
  { id: '6001+', label: '¥6,000 以上' },
  { id: 'unknown', label: '暂无日元定价' },
];

const SORTS = [
  { id: 'new', label: '最新' },
  { id: 'old', label: '最早' },
  { id: 'price-desc', label: '价格高→低' },
  { id: 'price-asc', label: '价格低→高' },
  { id: 'grade', label: '等级' },
  { id: 'name', label: '名称' },
];
---

<div class="gdb" data-browser data-page-size={PAGE_SIZE}>
  <div class="gdb__toolbar">
    <div class="gdb__searchbox">
      <input
        class="gdb__search"
        type="search"
        data-search
        placeholder="搜索型号、中文名、日文名、机体、系列……"
        aria-label="搜索条目"
        autocomplete="off"
      />
      <button class="gdb__clear" type="button" data-clear-search hidden>清空</button>
    </div>
    <div class="gdb__sortrow">
      <span class="sorter__label" id="gdb-sort-label">排序</span>
      <div class="sorter__group" role="group" aria-labelledby="gdb-sort-label">
        {
          SORTS.map((s) => (
            <button
              type="button"
              class="sorter__btn"
              data-sort={s.id}
              aria-pressed={s.id === 'new' ? 'true' : 'false'}
            >
              {s.label}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="gdb__facets">
    <div class="gdb__facet">
      <span class="sorter__label" id="gdb-f-grade">等级</span>
      <div class="sorter__group" role="group" aria-labelledby="gdb-f-grade" data-facet="grade">
        <button type="button" class="sorter__btn" data-value="" aria-pressed="true">
          全部<span class="sorter__count">{kits.length}</span>
        </button>
        {
          usedGrades.map((g) => (
            <button type="button" class="sorter__btn" data-value={g} aria-pressed="false">
              {gradeMeta(g).label}
              <span class="sorter__count">{gradeCounts.get(g) ?? 0}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="gdb__facet">
      <span class="sorter__label" id="gdb-f-series">系列</span>
      <div class="sorter__group" role="group" aria-labelledby="gdb-f-series" data-facet="series">
        <button type="button" class="sorter__btn" data-value="" aria-pressed="true">
          全部<span class="sorter__count">{kits.length}</span>
        </button>
        {
          usedSeries.map((s) => (
            <button type="button" class="sorter__btn" data-value={s} aria-pressed="false">
              {seriesMeta(s).label}
              <span class="sorter__count">
                {kits.filter((k) => k.series === s).length}
              </span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="gdb__facet">
      <span class="sorter__label" id="gdb-f-channel">渠道</span>
      <div class="sorter__group" role="group" aria-labelledby="gdb-f-channel" data-facet="channel">
        <button type="button" class="sorter__btn" data-value="" aria-pressed="true">
          全部<span class="sorter__count">{kits.length}</span>
        </button>
        {
          usedChannels.map((c) => (
            <button type="button" class="sorter__btn" data-value={c} aria-pressed="false">
              {channelMeta(c).label}
              <span class="sorter__count">{channelCounts.get(c) ?? 0}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="gdb__facet">
      <span class="sorter__label" id="gdb-f-decade">年代</span>
      <div class="sorter__group" role="group" aria-labelledby="gdb-f-decade" data-facet="decade">
        <button type="button" class="sorter__btn" data-value="" aria-pressed="true">
          全部<span class="sorter__count">{kits.length}</span>
        </button>
        {
          usedDecades.map((d) => (
            <button type="button" class="sorter__btn" data-value={d} aria-pressed="false">
              {d}
              <span class="sorter__count">{decadeCounts.get(d) ?? 0}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="gdb__facet">
      <span class="sorter__label" id="gdb-f-price">定价</span>
      <div class="sorter__group" role="group" aria-labelledby="gdb-f-price" data-facet="price">
        <button type="button" class="sorter__btn" data-value="" aria-pressed="true">
          全部<span class="sorter__count">{kits.length}</span>
        </button>
        {
          PRICE_BUCKETS.map((b) => (
            <button type="button" class="sorter__btn" data-value={b.id} aria-pressed="false">
              {b.label}
              <span class="sorter__count">{priceCounts.get(b.id) ?? 0}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="gdb__status">
    <p class="count" data-result aria-live="polite">共 {kits.length} 条</p>
    <button class="gdb__reset" type="button" data-reset hidden>清空全部筛选</button>
  </div>

  <div class="gdb__grid" data-grid>
    {
      firstPage.map((kit, i) => (
        <article
          class="gcard"
          data-reveal
          style={`--reveal-delay:${Math.min(i, 8) * 40}`}
          data-grade={kit.grade}
          data-series={kit.series}
          data-channel={kit.channel}
          data-year={releaseYear(kit.released)}
          data-price={kit.priceJpy}
          data-rk={releaseSortKey(kit.released)}
          data-name={kit.name}
          data-text={searchHaystack(kit)}
        >
          <a class="gcard__link" href={`/data/gundam/${kit.id}/`}>
            <span class="gcard__poster">
              {
                kit.image ? (
                  <>
                    <span class="gcard__blank" />
                    <img
                      class="gcard__photo"
                      src={kit.image}
                      alt={`${kit.name} 商品图`}
                      loading="lazy"
                      decoding="async"
                    />
                  </>
                ) : (
                  <span class="gcard__cover">
                    <span class="gcard__coverEyebrow">GUNDAM MODEL KIT</span>
                    <span class="gcard__coverSeries">{seriesMeta(kit.series).short}</span>
                    <span class="gcard__coverNote">官方图待补</span>
                  </span>
                )
              }
            </span>
            <span class="gcard__body">
              <span class="gcard__head">
                <span class="gcard__grade" data-grade={kit.grade}>{kit.grade}</span>
                <span class="gcard__scale">{kit.scale}</span>
                {
                  kit.channel !== 'general' && (
                    <span class="gcard__flag" data-channel={kit.channel}>
                      {channelMeta(kit.channel).label}
                    </span>
                  )
                }
              </span>
              <span class="gcard__title">{kit.name}</span>
              {kit.nameJa && <span class="gcard__sub">{kit.nameJa}</span>}
              <span class="gcard__meta">
                <time datetime={kit.released}>{releaseShort(kit.released)}</time>
                <span class="gcard__price">
                  {kit.priceJpy > 0
                    ? `¥${kit.priceJpy.toLocaleString('en-US')}`
                    : kit.priceCny > 0
                      ? `¥${kit.priceCny.toLocaleString('en-US')}`
                      : '—'}
                </span>
              </span>
              <span class="gcard__series">{seriesMeta(kit.series).label}</span>
            </span>
          </a>
        </article>
      ))
    }
  </div>

  <nav class="gdb__pager" data-pager hidden aria-label="分页">
    <button type="button" class="gdb__pagerBtn" data-page-prev>上一页</button>
    <span class="gdb__pagerInfo" data-page-info></span>
    <button type="button" class="gdb__pagerBtn" data-page-next>下一页</button>
  </nav>

  <p class="empty" data-empty hidden>没有符合条件的条目，试着放宽某个条件。</p>

  <noscript>
    <p class="gdb__noscript">
      筛选与分页需要 JavaScript。下面是全部条目的直达链接——
      <a href="/data/gundam/mech/">也可以按机体浏览</a>，
      <a href="/data/gundam/export.csv">下载 CSV</a>。
    </p>
    <ul class="gdb__noscriptList">
      {
        kits.map((kit) => (
          <li>
            <a href={`/data/gundam/${kit.id}/`}>{kit.name}</a>
            <span class="faint">
              　{kit.grade} {kit.scale} · {seriesMeta(kit.series).label}
            </span>
          </li>
        ))
      }
    </ul>
  </noscript>
</div>

<script>
  // 列表页的筛选、排序与分页。
  //
  // 服务端只渲染了第一页；完整数据在 /data/gundam/index.json 里，取回后
  // 由这里渲染。归一化、年代分档、价格分档的口径与服务端一致——分面上的
  // 数字全部按当前条件重算，所以永远和列表对得上。
  (function () {
    var root = document.querySelector('[data-browser]');
    if (!root) return;

    var PAGE_SIZE = Number(root.getAttribute('data-page-size')) || 60;
    var grid = root.querySelector('[data-grid]');
    var searchInput = root.querySelector('[data-search]');
    var clearSearchBtn = root.querySelector('[data-clear-search]');
    var resetBtn = root.querySelector('[data-reset]');
    var resultEl = root.querySelector('[data-result]');
    var emptyEl = root.querySelector('[data-empty]');
    var pager = root.querySelector('[data-pager]');
    var pagerInfo = root.querySelector('[data-page-info]');
    var prevBtn = root.querySelector('[data-page-prev]');
    var nextBtn = root.querySelector('[data-page-next]');
    var facetGroups = Array.prototype.slice.call(root.querySelectorAll('[data-facet]'));
    var sortButtons = Array.prototype.slice.call(root.querySelectorAll('[data-sort]'));

    var GRADE_ORDER = { PG: 0, MG: 1, MGSD: 2, RG: 3, MR: 4, FM: 5, GA: 6, FG: 7, HG: 8, EG: 9, SD: 10 };

    var state = { q: '', grade: '', series: '', channel: '', decade: '', price: '', sort: 'new', page: 1 };

    var DATA = null;
    var RECORDS = [];

    /* ---------------------------------------------------------- 数据 */

    function norm(value) {
      return (value || '')
        .toLowerCase()
        .replace(/[\s　·・,，.。/\\()（）\-_]/g, '');
    }

    function releaseYear(released) {
      var m = /^(\d{4})/.exec(released || '');
      return m ? Number(m[1]) : 0;
    }

    function releaseKey(released) {
      var m = /^(\d{4})(?:-(\d{1,2}))?(?:-(\d{1,2}))?/.exec(released || '');
      if (!m) return 0;
      return Number(m[1]) * 10000 + Number(m[2] || 1) * 100 + Number(m[3] || 1);
    }

    function releaseShort(released) {
      var m = /^(\d{4})(?:-(\d{1,2}))?(?:-(\d{1,2}))?/.exec(released || '');
      if (!m) return '';
      if (!m[2]) return m[1];
      if (!m[3]) return m[1] + '.' + String(Number(m[2])).padStart(2, '0');
      return m[1] + '.' + String(Number(m[2])).padStart(2, '0') + '.' + String(Number(m[3])).padStart(2, '0');
    }

    function decadeOf(year) {
      if (!year) return '未知';
      return Math.floor(year / 10) * 10 + 's';
    }

    function priceBucket(price) {
      if (!price) return 'unknown';
      if (price <= 1000) return '0-1000';
      if (price <= 3000) return '1001-3000';
      if (price <= 6000) return '3001-6000';
      return '6001+';
    }

    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function buildRecords(payload) {
      var idx = {};
      payload.fields.forEach(function (f, i) {
        idx[f] = i;
      });
      return payload.rows.map(function (row) {
        var r = {};
        payload.fields.forEach(function (f, i) {
          r[f] = row[i];
        });
        r.year = releaseYear(r.released);
        r.rk = releaseKey(r.released);
        /* 检索文本在客户端拼，与服务端的 searchHaystack 同一套口径 */
        r.hay = norm(
          [
            r.name,
            r.nameJa,
            r.id,
            'BANDAI SPIRITS',
            r.grade,
            payload.grades[r.grade] || '',
            payload.series[r.series] || '',
            payload.seriesShort[r.series] || '',
            payload.channels[r.channel] || '',
            r.scale,
            r.mech || '',
            (r.aliases || []).join(' '),
            (r.tags || []).join(' '),
          ].join(' '),
        );
        return r;
      });
    }

    /* ---------------------------------------------------------- 卡片 */

    function cardHTML(r, i) {
      var img = r.image
        ? '<span class="gcard__blank"></span>' +
          '<img class="gcard__photo" src="' + esc(r.image) + '" alt="' + esc(r.name) +
          ' 商品图" loading="lazy" decoding="async">'
        : '<span class="gcard__cover"><span class="gcard__coverEyebrow">GUNDAM MODEL KIT</span>' +
          '<span class="gcard__coverSeries">' + esc(DATA.seriesShort[r.series] || '') + '</span>' +
          '<span class="gcard__coverNote">官方图待补</span></span>';
      var flag =
        r.channel !== 'general'
          ? '<span class="gcard__flag" data-channel="' + esc(r.channel) + '">' +
            esc(DATA.channels[r.channel] || '') + '</span>'
          : '';
      var price = r.priceJpy
        ? '¥' + r.priceJpy.toLocaleString('en-US')
        : r.priceCny
          ? '¥' + r.priceCny.toLocaleString('en-US')
          : '—';
      return (
        '<article class="gcard" data-reveal style="--reveal-delay:' + Math.min(i, 8) * 40 + '"' +
        ' data-grade="' + esc(r.grade) + '" data-series="' + esc(r.series) + '"' +
        ' data-channel="' + esc(r.channel) + '" data-year="' + r.year + '"' +
        ' data-price="' + r.priceJpy + '" data-rk="' + r.rk + '"' +
        ' data-name="' + esc(r.name) + '" data-text="' + esc(r.hay) + '">' +
        '<a class="gcard__link" href="/data/gundam/' + encodeURIComponent(r.id) + '/">' +
        '<span class="gcard__poster">' + img + '</span>' +
        '<span class="gcard__body">' +
        '<span class="gcard__head">' +
        '<span class="gcard__grade" data-grade="' + esc(r.grade) + '">' + esc(r.grade) + '</span>' +
        '<span class="gcard__scale">' + esc(r.scale) + '</span>' + flag +
        '</span>' +
        '<span class="gcard__title">' + esc(r.name) + '</span>' +
        (r.nameJa ? '<span class="gcard__sub">' + esc(r.nameJa) + '</span>' : '') +
        '<span class="gcard__meta"><time datetime="' + esc(r.released) + '">' +
        releaseShort(r.released) + '</time>' +
        '<span class="gcard__price">' + price + '</span></span>' +
        '<span class="gcard__series">' + esc(DATA.series[r.series] || '') + '</span>' +
        '</span></a></article>'
      );
    }

    /* ---------------------------------------------------------- 筛选 */

    function matches(r, s) {
      if (s.q && r.hay.indexOf(norm(s.q)) === -1) return false;
      if (s.grade && r.grade !== s.grade) return false;
      if (s.series && r.series !== s.series) return false;
      if (s.channel && r.channel !== s.channel) return false;
      if (s.decade && decadeOf(r.year) !== s.decade) return false;
      if (s.price && priceBucket(r.priceJpy) !== s.price) return false;
      return true;
    }

    function withFacet(s, key, value) {
      var out = {};
      for (var k in s) if (Object.prototype.hasOwnProperty.call(s, k)) out[k] = s[k];
      out[key] = value;
      return out;
    }

    function priceCompare(a, b) {
      var pa = a.priceJpy;
      var pb = b.priceJpy;
      if (!pa && !pb) return 0;
      if (!pa) return 1;
      if (!pb) return -1;
      return pa - pb;
    }

    function comparator(a, b) {
      var d = 0;
      if (state.sort === 'new') d = b.rk - a.rk;
      else if (state.sort === 'old') d = a.rk - b.rk;
      else if (state.sort === 'price-desc') d = priceCompare(b, a);
      else if (state.sort === 'price-asc') d = priceCompare(a, b);
      else if (state.sort === 'grade')
        d = (GRADE_ORDER[a.grade] || 99) - (GRADE_ORDER[b.grade] || 99);
      else if (state.sort === 'name') d = a.name.localeCompare(b.name, 'zh-Hans-CN');
      if (d !== 0) return d;
      return b.rk - a.rk;
    }

    /* ---------------------------------------------------------- 渲染 */

    function apply() {
      if (!DATA) return;
      var visible = [];
      for (var i = 0; i < RECORDS.length; i++) {
        if (matches(RECORDS[i], state)) visible.push(RECORDS[i]);
      }
      visible.sort(comparator);

      var total = visible.length;
      var pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
      if (state.page > pages) state.page = pages;
      if (state.page < 1) state.page = 1;
      var start = (state.page - 1) * PAGE_SIZE;
      var slice = visible.slice(start, start + PAGE_SIZE);

      grid.innerHTML = slice.map(cardHTML).join('');

      if (resultEl) resultEl.textContent = '共 ' + total + ' 条';
      if (emptyEl) emptyEl.hidden = total !== 0;
      if (pager) pager.hidden = pages <= 1;
      if (pagerInfo) pagerInfo.textContent = '第 ' + state.page + ' / ' + pages + ' 页';
      if (prevBtn) prevBtn.disabled = state.page <= 1;
      if (nextBtn) nextBtn.disabled = state.page >= pages;

      /* 分面计数：把该分面本身换成候选值，看还剩多少条 */
      for (var g = 0; g < facetGroups.length; g++) {
        var key = facetGroups[g].getAttribute('data-facet');
        var buttons = facetGroups[g].querySelectorAll('[data-value]');
        for (var b = 0; b < buttons.length; b++) {
          var value = buttons[b].getAttribute('data-value') || '';
          var probe = withFacet(state, key, value);
          var count = 0;
          for (var c = 0; c < RECORDS.length; c++) if (matches(RECORDS[c], probe)) count++;
          var slot = buttons[b].querySelector('.sorter__count');
          if (slot) slot.textContent = String(count);
          buttons[b].setAttribute('aria-pressed', value === state[key] ? 'true' : 'false');
        }
      }

      for (var s = 0; s < sortButtons.length; s++) {
        sortButtons[s].setAttribute(
          'aria-pressed',
          sortButtons[s].getAttribute('data-sort') === state.sort ? 'true' : 'false',
        );
      }

      if (resetBtn)
        resetBtn.hidden =
          !state.q &&
          !state.grade &&
          !state.series &&
          !state.channel &&
          !state.decade &&
          !state.price;
      if (clearSearchBtn) clearSearchBtn.hidden = !state.q;
    }

    function syncUrl() {
      var url = new URL(window.location.href);
      var params = url.searchParams;
      if (state.q) params.set('q', state.q);
      else params.delete('q');
      ['grade', 'series', 'channel', 'decade', 'price'].forEach(function (key) {
        if (state[key]) params.set(key, state[key]);
        else params.delete(key);
      });
      if (state.sort && state.sort !== 'new') params.set('sort', state.sort);
      else params.delete('sort');
      if (state.page > 1) params.set('page', String(state.page));
      else params.delete('page');
      window.history.replaceState(null, '', url);
    }

    function readUrl() {
      var params = new URLSearchParams(window.location.search);
      var next = { q: '', grade: '', series: '', channel: '', decade: '', price: '', sort: 'new', page: 1 };
      next.q = params.get('q') || '';
      ['grade', 'series', 'channel', 'decade', 'price'].forEach(function (key) {
        var value = params.get(key);
        if (value) next[key] = value;
      });
      var sort = params.get('sort');
      if (sort) next.sort = sort;
      var page = Number(params.get('page'));
      if (page > 0) next.page = page;
      return next;
    }

    /* 从 URL 读进来的条件必须真的能匹配到条目，否则会得到一个空网格 */
    function sanitize(next) {
      var probe = withFacet(next, 'q', '');
      ['grade', 'series', 'channel', 'decade', 'price'].forEach(function (key) {
        probe = withFacet(probe, key, '');
      });
      ['grade', 'series', 'channel', 'decade', 'price'].forEach(function (key) {
        if (!next[key]) return;
        var candidate = withFacet(probe, key, next[key]);
        for (var i = 0; i < RECORDS.length; i++) {
          if (matches(RECORDS[i], candidate)) return;
        }
        next[key] = '';
      });
      return next;
    }

    /* ---------------------------------------------------------- 事件 */

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        state.q = searchInput.value;
        state.page = 1;
        apply();
        syncUrl();
      });
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', function () {
        state.q = '';
        state.page = 1;
        if (searchInput) searchInput.value = '';
        apply();
        syncUrl();
        if (searchInput) searchInput.focus();
      });
    }

    facetGroups.forEach(function (group) {
      var key = group.getAttribute('data-facet');
      group.addEventListener('click', function (event) {
        var button = event.target.closest ? event.target.closest('[data-value]') : null;
        if (!button || !group.contains(button)) return;
        state[key] = button.getAttribute('data-value') || '';
        state.page = 1;
        apply();
        syncUrl();
      });
    });

    sortButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        state.sort = button.getAttribute('data-sort') || 'new';
        state.page = 1;
        apply();
        syncUrl();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        state.q = '';
        state.grade = '';
        state.series = '';
        state.channel = '';
        state.decade = '';
        state.price = '';
        state.page = 1;
        if (searchInput) searchInput.value = '';
        apply();
        syncUrl();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        if (state.page > 1) state.page--;
        apply();
        syncUrl();
        grid.scrollIntoView({ block: 'start', behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        state.page++;
        apply();
        syncUrl();
        grid.scrollIntoView({ block: 'start', behavior: 'smooth' });
      });
    }

    /* ---------------------------------------------------------- 启动 */

    fetch('/data/gundam/index.json')
      .then(function (res) {
        return res.json();
      })
      .then(function (payload) {
        DATA = payload;
        RECORDS = buildRecords(payload);
        var next = sanitize(readUrl());
        for (var key in next) if (Object.prototype.hasOwnProperty.call(next, key)) state[key] = next[key];
        if (searchInput) searchInput.value = state.q ? state.q : '';
        apply();
      })
      .catch(function () {
        /* 取不到数据就留着服务端渲染的第一页 */
      });
  })();
</script>
