---
/**
 * 数据概览 · 年代分布与等级构成
 *
 * 这些数字全部由条目本身算出来，没有任何外部统计口径：年代分布回答
 * "这条产品线长什么样"，等级构成回答"库里都收了些什么"。放在列表上方，
 * 是为了让访客先看到全局，再挑自己要看的那一格。
 */
import { countBy, gradeMeta, releaseYear, decadeOf, type GundamKit } from '../../data/gundam';

interface Props {
  kits: GundamKit[];
}

const { kits } = Astro.props;

/** 按年代分桶，空的年代也保留，好让横轴的时间感是连续的 */
const decadeCounts = countBy(kits, (k) => decadeOf(releaseYear(k.released)), (id) => id);
const decades = [...decadeCounts].sort((a, b) => a.id.localeCompare(b.id));
const decadeMax = Math.max(1, ...decades.map((d) => d.count));

const gradeCounts = countBy(kits, (k) => k.grade, (id) => gradeMeta(id).label);
const gradeMax = Math.max(1, ...gradeCounts.map((g) => g.count));
/** 最多的两条等级线，按条目数说话，不写死 */
const topGrades = gradeCounts.slice(0, 2).map((g) => g.label).join(' 与 ');
const hasAssemble = kits.some((k) => k.grade === 'GA');

const earliest = kits.reduce(
  (min, k) => (releaseYear(k.released) && (!min || releaseYear(k.released) < releaseYear(min.released)) ? k : min),
  null as GundamKit | null,
);
const latest = kits.reduce(
  (max, k) => (releaseYear(k.released) > releaseYear(max.released) ? k : max),
  kits[0],
);
---

<section class="gstats" aria-label="数据库概览">
  <div class="gstats__block">
    <h2 class="gstats__title">年代分布</h2>
    <p class="gstats__desc">
      按发售年份统计收录条目。库里的时间跨度从 {earliest ? releaseYear(earliest.released) : '—'} 年到
      {latest ? releaseYear(latest.released) : '—'} 年。
    </p>
    <ul class="gstats__bars">
      {
        decades.map((d) => (
          <li class="gstats__bar-row">
            <span class="gstats__bar-label">{d.id}</span>
            <span class="gstats__bar-track">
              <span class="gstats__bar-fill" style={`--w:${(d.count / decadeMax) * 100}%`} />
            </span>
            <span class="gstats__bar-num">{d.count}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="gstats__block">
    <h2 class="gstats__title">等级构成</h2>
    <p class="gstats__desc">
      {topGrades} 是收录最多的两条线；PG 与 MR 条目少，但单条的信息量最大。
      {hasAssemble && 'GA 是 2026 年起新增的桌面战棋线（高达集结）。'}
    </p>
    <ul class="gstats__bars">
      {
        gradeCounts.map((g) => (
          <li class="gstats__bar-row">
            <span class="gstats__bar-label">{g.label}</span>
            <span class="gstats__bar-track">
              <span class="gstats__bar-fill" data-grade={g.id} style={`--w:${(g.count / gradeMax) * 100}%`} />
            </span>
            <span class="gstats__bar-num">{g.count}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
