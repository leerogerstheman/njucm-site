---
import type { Doc } from '../utils/content';

interface Props {
  docs: Doc[];
  emptyHint?: string;
  /** cap the number of grid columns; omit to auto-fill the row */
  columns?: number;
  /**
   * Randomise the visual order on every page load.
   *
   * Only the CSS `order` of each card is shuffled — the DOM order stays as
   * rendered (newest first), so crawlers, no-JS visitors and the tab order all
   * still see a chronological list. That also means nothing is moved in the
   * DOM, so no listeners or anchors can be disturbed.
   */
  shuffle?: boolean;
}

const { docs, emptyHint = '这个栏目还没有内容。', columns, shuffle = false } = Astro.props;

// A doc list never wants the fixed 4-column section-card layout, and squeezing
// two entries into four columns makes the cards unreadably narrow. `auto` opts
// out of the wide-screen override in global.css; callers can still pin a count.
const colStyle = columns
  ? `repeat(${columns}, minmax(0, 1fr))`
  : `repeat(auto-fill, minmax(min(100%, 21rem), 1fr))`;
---

{
  docs.length === 0 ? (
    <p class="empty">{emptyHint}</p>
  ) : (
    <div
      class="grid"
      data-shuffle={shuffle ? '' : undefined}
      style={`grid-template-columns:${colStyle}`}
    >
      {docs.map((doc) => (
        <article class="card">
          <h2 class="card__title">
            <a href={doc.href}>{doc.title}</a>
          </h2>

          {doc.description && <p class="card__desc">{doc.description}</p>}

          <div class="card__meta">
            {doc.date && (
              <time datetime={doc.date.toISOString()}>
                {doc.date.toISOString().slice(0, 10)}
              </time>
            )}
            {doc.status && <span class={`tag tag--${doc.status}`}>{doc.status}</span>}
            {doc.repo && (
              <a class="tag tag--repo" href={doc.repo} rel="noopener noreferrer" target="_blank">
                仓库
              </a>
            )}
            {doc.tags.slice(0, 3).map((tag) => (
              <span class="tag">{tag}</span>
            ))}
            {doc.draft && <span class="tag">draft</span>}
          </div>
        </article>
      ))}
    </div>
  )
}
