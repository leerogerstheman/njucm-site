---
import type { Doc } from '../utils/content';

interface Props {
  docs: Doc[];
  emptyHint?: string;
  /** cap the number of grid columns; omit to auto-fill the row */
  columns?: number;
  /**
   * Marks the grid as client-sortable and stamps each card with its repo dates,
   * so the /projects page can offer random / newest-updated / newest-created
   * ordering.
   *
   * Only each card's CSS `order` is ever changed — the DOM keeps the order it
   * was rendered in, so crawlers, no-JS visitors and the tab sequence all still
   * get a stable list, and nothing moves (so no listeners or anchors can break).
   */
  sortable?: boolean;
}

const { docs, emptyHint = '这个栏目还没有内容。', columns, sortable = false } = Astro.props;

// A doc list never wants the fixed 4-column section-card layout. When a caller
// pins `columns`, we hand it to CSS as data-cols rather than an inline
// grid-template-columns, so the stylesheet can still collapse it on narrow
// screens — an inline declaration would win over any media query.
//
// A pinned count is an upper bound, not a promise: asking for 3 columns with a
// single entry must not strand that entry in the first of three tracks with two
// empty columns beside it. Clamping to the item count turns the lone card into
// a full-width row, which is what one card should have been all along.
// The same reasoning applies unpinned: a 1–2 entry list gets an exact column
// count instead of leaning on auto-fit, whose collapsed-track behaviour varies.
const cols = columns
  ? Math.min(columns, docs.length)
  : docs.length <= 2
    ? docs.length
    : undefined;
const colStyle = cols ? undefined : 'repeat(auto-fit, minmax(min(100%, 21rem), 1fr))';
---

{
  docs.length === 0 ? (
    <p class="empty">{emptyHint}</p>
  ) : (
    <div
      class="grid"
      data-cols={cols}
      data-sortable={sortable ? '' : undefined}
      style={colStyle}
    >
      {docs.map((doc, i) => (
        <article
          class="card"
          data-reveal
          /* 卡片只错开前 8 张：再多就变成拖沓，而不是节奏 */
          style={`--reveal-delay:${Math.min(i, 8) * 45}`}
          data-created={doc.created ? doc.created.toISOString().slice(0, 10) : undefined}
          data-updated={doc.updated ? doc.updated.toISOString().slice(0, 10) : undefined}
        >
          <h2 class="card__title">
            <a href={doc.href}>{doc.title}</a>
          </h2>

          {doc.description && <p class="card__desc">{doc.description}</p>}

          <div class="card__meta">
            {doc.date && (
              <time datetime={doc.date.toISOString()}>
                {doc.date.toISOString().slice(0, 10)}
              </time>
            )}
            {doc.status && <span class={`tag tag--${doc.status}`}>{doc.status}</span>}
            {doc.repo && (
              <a class="tag tag--repo" href={doc.repo} rel="noopener noreferrer" target="_blank">
                仓库
              </a>
            )}
            {doc.tags.slice(0, 3).map((tag) => (
              <span class="tag">{tag}</span>
            ))}
            {doc.draft && <span class="tag">draft</span>}
          </div>
        </article>
      ))}
    </div>
  )
}
