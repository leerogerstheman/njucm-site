---
/**
 * 栏目专属线稿插图。
 *
 * 四个栏目各有一枚手写的小图，都用同一套描边语言（1.5px 圆头线、无填充），
 * 这样它们看起来像出自同一本图鉴，而不是四套图标库。颜色交给 currentColor，
 * 卡片悬停时由外层把 color 切到强调色——插图因此也参与了悬停反馈。
 */
interface Props {
  name: 'notes' | 'data' | 'projects' | 'about';
  /** 无障碍描述；省略则视为纯装饰 */
  label?: string;
}

const { name, label } = Astro.props;
---

{
  label ? (
    <svg class="glyph" viewBox="0 0 48 48" role="img" aria-label={label}>
      {name === 'notes' && (
        <g>
          <rect x="15" y="11" width="19" height="29" rx="3" />
          <path d="M21 16v19M28 16v19" />
          <path d="M15 21h19M15 29h19" opacity="0.45" />
          <path d="M34 30c6-2 9-7 8-13-6 1-9 6-8 13Z" class="glyph__fill" />
        </g>
      )}
      {name === 'data' && (
        <g>
          <path d="M10 10v28h29" />
          <path d="M13 33l7-9 6 5 8-13" />
          <circle cx="20" cy="24" r="2.2" class="glyph__fill" />
          <circle cx="34" cy="16" r="2.2" class="glyph__fill" />
        </g>
      )}
      {name === 'projects' && (
        <g>
          <path d="M24 12l9 5.5v11L24 34l-9-5.5v-11Z" />
          <path d="M33 17.5l6-3.5M15 28.5l-6 3.5" />
          <circle cx="24" cy="23" r="2.6" class="glyph__fill" />
          <circle cx="39" cy="14" r="2.2" class="glyph__fill" />
        </g>
      )}
      {name === 'about' && (
        <g>
          <path d="M24 9c7.5 9.5 11.5 14.5 11.5 19.5a11.5 11.5 0 0 1-23 0C12.5 23.5 16.5 18.5 24 9Z" />
          <circle cx="24" cy="28.5" r="4" class="glyph__fill" />
        </g>
      )}
    </svg>
  ) : (
    <svg class="glyph" viewBox="0 0 48 48" aria-hidden="true">
      {name === 'notes' && (
        <g>
          <rect x="15" y="11" width="19" height="29" rx="3" />
          <path d="M21 16v19M28 16v19" />
          <path d="M15 21h19M15 29h19" opacity="0.45" />
          <path d="M34 30c6-2 9-7 8-13-6 1-9 6-8 13Z" class="glyph__fill" />
        </g>
      )}
      {name === 'data' && (
        <g>
          <path d="M10 10v28h29" />
          <path d="M13 33l7-9 6 5 8-13" />
          <circle cx="20" cy="24" r="2.2" class="glyph__fill" />
          <circle cx="34" cy="16" r="2.2" class="glyph__fill" />
        </g>
      )}
      {name === 'projects' && (
        <g>
          <path d="M24 12l9 5.5v11L24 34l-9-5.5v-11Z" />
          <path d="M33 17.5l6-3.5M15 28.5l-6 3.5" />
          <circle cx="24" cy="23" r="2.6" class="glyph__fill" />
          <circle cx="39" cy="14" r="2.2" class="glyph__fill" />
        </g>
      )}
      {name === 'about' && (
        <g>
          <path d="M24 9c7.5 9.5 11.5 14.5 11.5 19.5a11.5 11.5 0 0 1-23 0C12.5 23.5 16.5 18.5 24 9Z" />
          <circle cx="24" cy="28.5" r="4" class="glyph__fill" />
        </g>
      )}
    </svg>
  )
}

<style>
  .glyph {
    width: 1.65rem;
    height: 1.65rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }

  /* 少数实心点作为视觉落点，其余全部留白 */
  .glyph__fill {
    fill: currentColor;
    stroke: none;
  }
</style>
