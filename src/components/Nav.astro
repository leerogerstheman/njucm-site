---
import type { NavItem } from '../data/site';

interface Props {
  items: NavItem[];
  /** current pathname, e.g. Astro.url.pathname */
  current: string;
}

const { items, current } = Astro.props;

const isActive = (href: string) => {
  const path = current.replace(/\/+$/, '') || '/';
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
};
---

<!--
  `popover` is what powers the narrow-screen menu: the browser opens it from the
  header button, closes it on Esc or an outside click, and renders the backdrop.
  No JavaScript is involved. On wide screens CSS returns this same list to
  normal flow.
-->
<ul class="nav__list" id="site-nav-list" popover>
  {items.map((item) => (
    <li>
      <a
        class="nav__link"
        href={item.href}
        aria-current={isActive(item.href) ? 'page' : undefined}
      >
        {item.label}
      </a>
    </li>
  ))}
</ul>
