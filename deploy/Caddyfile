# njucm.org —— 静态站点托管配置
#
# Caddy 负责三件事：自动签发 TLS 证书（Let's Encrypt）、压缩、按路径给缓存头。
# 站点是纯静态的（构建产物整份丢进 /srv），所以换服务器、换托管方都不用改代码。
#
# 域名先指向服务器，再起 Caddy——证书签发要能回源到这台机器。

{
	# 证书到期前的提醒邮箱（换成你自己的）
	email {$ACME_EMAIL:admin@njucm.org}
}

www.njucm.org {
	redir https://njucm.org{uri} permanent
}

njucm.org {
	encode gzip zstd

	# 商品图：文件名带 hash 之外也不变，但内容不常改，给足一年
	@gundam path /gundam/*
	handle @gundam {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 数据接口：导出与索引，会随数据更新重新生成
	@data path /data/models/*.json /data/models/*.csv
	handle @data {
		header Cache-Control "public, max-age=600"
		header Access-Control-Allow-Origin "*"
		file_server
	}

	# 其余页面：缓存短一点，改完数据重新部署就够快
	handle {
		header Cache-Control "public, max-age=300"
		header X-Content-Type-Options "nosniff"
		header Referrer-Policy "strict-origin-when-cross-origin"
		try_files {path} {path}/index.html
		file_server
	}

	header /robots.txt {
		Cache-Control "public, max-age=3600"
	}
}
